<Project Sdk="Godot.NET.Sdk/4.7.2">
    <PropertyGroup>
        <Version>0.1.0</Version>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
        <FileVersion>0.1.0.0</FileVersion>

        <TargetFramework>net10.0</TargetFramework>
        <TargetFramework Condition=" '$(GodotTargetPlatform)' == 'android' ">net10.0</TargetFramework>
        <EnableDynamicLoading>true</EnableDynamicLoading>

        <IsPackable>false</IsPackable>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Vinland</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Core -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="Microsoft.Extensions.ObjectPool" Version="10.0.8" />

        <!-- Persistence -->
        <PackageReference Include="LiteDB" Version="5.0.21" />

        <!-- Logging -->
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />

        <!-- FSM -->
        <PackageReference Include="Stateless" Version="5.20.1" />

        <!-- ReGoap — если пакет есть на NuGet. Иначе раскомментируй ProjectReference -->
        <!-- <PackageReference Include="ReGoap" Version="*" /> -->
        <!-- <ProjectReference Include="libs/ReGoap/ReGoap.csproj" /> -->
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4" />
        <PackageReference Include="FluentAssertions" Version="6.12.0" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageReference Include="Moq" Version="4.20.70" />
        <PackageReference Include="xunit" Version="2.9.3" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    </ItemGroup>
    
    <ItemGroup>
        <Using Include="Xunit" />
        <Compile Remove="scripts/Old/**/*.cs" />
        <Compile Remove="tests/Old/**/*.cs" />
    </ItemGroup>

</Project>